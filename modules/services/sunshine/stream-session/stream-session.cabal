cabal-version: 3.0
name: stream-session
version: 0.1.0.0
build-type: Simple
license: MIT

library
  exposed-modules: Stream.Model, Stream.Controller
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, aeson, bytestring, text, directory, filepath, process, unix, network, async
  default-language: GHC2021
  ghc-options: -Wall -Wcompat

executable stream-session
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base, stream-session
  default-language: GHC2021
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2

test-suite model-tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base, stream-session, aeson
  default-language: GHC2021
  ghc-options: -Wall

test-suite integration-tests
  type: exitcode-stdio-1.0
  main-is: Integration.hs
  hs-source-dirs: test
  build-tool-depends: stream-session:stream-session
  build-depends: base, aeson, bytestring, directory, filepath, process, unix, network, async
  default-language: GHC2021
  ghc-options: -Wall -threaded
